@model IEnumerable<CarRentPro.Models.Vehicle>

@{
    ViewData["Title"] = "Home Page";

    var allBrands = Model.Select(v => v.Brand).Distinct().OrderBy(b => b).ToList();
    var allYears = Model.Select(v => v.Year).Distinct().OrderByDescending(y => y).ToList();
}

<div class="container">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 mb-4">Welcome to CarRentPro</h1>
            <p class="lead">Find the perfect car for your journey</p>

            <div class="row justify-content-center mb-4">
                <div class="col-md-10">
                    <form method="get" asp-controller="Vehicle" asp-action="Search" class="card p-4 shadow-sm mb-3" id="searchForm">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Search Vehicles</label>
                                <div class="input-group position-relative">
                                    <input type="text"
                                           class="form-control"
                                           name="searchTerm"
                                           placeholder="Search by brand, model, color, year..."
                                           id="searchInput"
                                           autocomplete="off"
                                           value="@Context.Request.Query["searchTerm"]">
                                    <button class="btn btn-primary" type="submit" id="searchButton">
                                        <i class="fas fa-search"></i> Search
                                    </button>
                                    <div id="autocompleteResults" class="autocomplete-dropdown"></div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <a class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" href="#advancedFilters" role="button">
                                    <i class="fas fa-filter"></i> Advanced Filters
                                </a>

                                <div class="collapse mt-3" id="advancedFilters">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Brand</label>
                                            <select class="form-select" name="brandFilter" id="brandFilter">
                                                <option value="">All Brands</option>
                                                @foreach (var brand in allBrands)
                                                {
                                                    <option value="@brand">@brand</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Year</label>
                                            <select class="form-select" name="yearFilter" id="yearFilter">
                                                <option value="">All Years</option>
                                                @foreach (var year in allYears)
                                                {
                                                    <option value="@year">@year</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Price Range</label>
                                            <select class="form-select" name="priceFilter" id="priceFilter">
                                                <option value="">Any Price</option>
                                                <option value="0-50">$0 - $50</option>
                                                <option value="51-100">$51 - $100</option>
                                                <option value="101-200">$101 - $200</option>
                                                <option value="201-500">$201 - $500</option>
                                                <option value="501+">$501+</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-12 text-end">
                                            <button type="submit" class="btn btn-primary">Apply Filters</button>
                                            <button type="button" class="btn btn-outline-secondary" onclick="clearFilters()">Clear</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row" id="vehicleGrid">
            @foreach (var vehicle in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4 vehicle-card"
                     data-brand="@vehicle.Brand"
                     data-model="@vehicle.Model"
                     data-year="@vehicle.Year"
                     data-color="@vehicle.Color"
                     data-price="@vehicle.PricePerDay"
                     data-branch="@vehicle.Branch?.Name"
                     data-available="@vehicle.IsAvailable.ToString().ToLower()">
                    <div class="card h-100 shadow-sm">
                        <img src="@vehicle.ImageUrl"
                             class="card-img-top vehicle-image"
                             alt="@vehicle.Brand @vehicle.Model"
                             onerror="this.onerror=null; this.src='/images/vehicles/default-car.jpg'">

                        <div class="card-body">
                            <h5 class="card-title">@vehicle.Brand @vehicle.Model</h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="fas fa-calendar-alt"></i> @vehicle.Year |
                                    <i class="fas fa-map-marker-alt"></i> @vehicle.Branch?.Name
                                </small>
                            </p>
                            <p class="card-text vehicle-description">@vehicle.Description</p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h5 mb-0 text-primary">$@vehicle.PricePerDay/day</span>
                                @if (vehicle.IsAvailable)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rented</span>
                                }
                            </div>
                            <div class="d-grid gap-2">
                                @if (vehicle.IsAvailable)
                                {
                                    <a href="@Url.Action("Rent", "Rental", new { id = vehicle.Id })" class="btn btn-primary btn-sm">
                                        <i class="fas fa-car"></i> Rent Now
                                    </a>
                                }
                                <a href="@Url.Action("Details", "Vehicle", new { id = vehicle.Id })" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-info-circle"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div id="ai-chat-widget" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;">
    <button id="toggle-chat" class="btn btn-primary rounded-circle shadow position-relative" style="width: 60px; height: 60px;">
        <i class="fas fa-robot fa-lg"></i>
    </button>

    <div id="chat-window" class="card shadow mt-2" style="display: none; width: 350px; border-radius: 15px; overflow: hidden;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-headset me-2"></i>AI Consultant</h6>
            <div>
                <button id="voice-toggle" class="btn btn-sm btn-outline-secondary text-white me-2">
                    <i class="fas fa-volume-up" id="voice-icon"></i>
                </button>
                <button id="clear-chat" class="btn btn-sm btn-outline-secondary text-white me-2">
                    <i class="fas fa-trash"></i>
                </button>
                <button id="close-chat" class="btn btn-sm btn-light py-0">X</button>
            </div>
        </div>

        <div class="card-body" id="chat-messages" style="height: 350px; overflow-y: auto; background-color: #f8f9fa;">
            <div class="text-muted small text-center mt-2 welcome-msg">
                Salut! Spune-mi ce cauți și te voi ajuta!
            </div>
        </div>

        <div class="card-footer p-2 bg-white">
            <div id="typing-indicator" class="small text-muted mb-2 ms-2" style="display: none;">
                <i class="fas fa-circle-notch fa-spin"></i> Scrie...
            </div>
            <div class="input-group">
                <input type="text" id="user-input" class="form-control border-end-0" placeholder="Scrie ceva..." style="border-radius: 20px 0 0 20px;" />
                <button id="mic-btn" class="btn btn-outline-secondary border-start-0" type="button">
                    <i class="fas fa-microphone"></i>
                </button>
                <button id="send-btn" class="btn btn-primary" style="border-radius: 0 20px 20px 0;">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .vehicle-image {
        height: 200px;
        object-fit: cover;
        width: 100%;
    }

    .vehicle-card {
        transition: transform 0.2s;
    }

        .vehicle-card:hover {
            transform: translateY(-5px);
        }

    .card {
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .autocomplete-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #ddd;
        z-index: 1000;
        display: none;
    }

    .autocomplete-item {
        padding: 10px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }

        .autocomplete-item:hover, .autocomplete-item.highlight {
            background-color: #f8f9fa;
        }

    .vehicle-description {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        height: 45px;
    }

    /* Animations */
    .fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .listening {
        animation: pulse-red 1.5s infinite;
        background-color: #dc3545 !important;
        color: white !important;
    }

    @@keyframes pulse-red {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
</style>

@section Scripts {
    <script>
        let vehicleSuggestions = [];

        document.addEventListener('DOMContentLoaded', function() {
            // Setup Autocomplete Data
            document.querySelectorAll('.vehicle-card').forEach(card => {
                const fields = ['brand', 'model', 'color', 'year', 'branch'];
                fields.forEach(f => {
                    const val = card.dataset[f];
                    if (val && !vehicleSuggestions.some(s => s.text === val))
                        vehicleSuggestions.push({ text: val, type: f });
                });
            });

            initializeAutocomplete();
            initializeSmartChat();
            populateFilterValuesFromUrl();
        });

        function initializeSmartChat() {
            const toggleBtn = document.getElementById('toggle-chat'), chatWindow = document.getElementById('chat-window'),
                  closeBtn = document.getElementById('close-chat'), clearBtn = document.getElementById('clear-chat'),
                  sendBtn = document.getElementById('send-btn'), micBtn = document.getElementById('mic-btn'),
                  voiceBtn = document.getElementById('voice-toggle'), voiceIcon = document.getElementById('voice-icon'),
                  msgArea = document.getElementById('chat-messages'), input = document.getElementById('user-input'),
                  typingIndicator = document.getElementById('typing-indicator');

            let isVoiceEnabled = JSON.parse(localStorage.getItem('carRentVoiceEnabled')) ?? true;
            updateVoiceButtonUI();

            // Voice Toggle
            voiceBtn.onclick = () => {
                isVoiceEnabled = !isVoiceEnabled;
                localStorage.setItem('carRentVoiceEnabled', isVoiceEnabled);
                updateVoiceButtonUI();
                if(!isVoiceEnabled) window.speechSynthesis.cancel();
            };

            function updateVoiceButtonUI() {
                voiceIcon.className = isVoiceEnabled ? "fas fa-volume-up" : "fas fa-volume-mute";
                voiceBtn.className = isVoiceEnabled ? "btn btn-sm btn-outline-secondary text-white me-2" : "btn btn-sm btn-outline-danger text-danger me-2";
            }

            // Load History
            const history = JSON.parse(localStorage.getItem('carRentChatHistory')) || [];
            if(history.length > 0) {
                document.querySelector('.welcome-msg').style.display = 'none';
                history.forEach(m => appendMessageToUI(m.text, m.sender, false));
            }

            toggleBtn.onclick = () => { chatWindow.style.display = 'block'; toggleBtn.style.display = 'none'; msgArea.scrollTop = msgArea.scrollHeight; };
            closeBtn.onclick = () => { chatWindow.style.display = 'none'; toggleBtn.style.display = 'block'; };
            clearBtn.onclick = () => { if(confirm('Ștergi chat-ul?')) { localStorage.removeItem('carRentChatHistory'); location.reload(); } };

            const sendMessage = async () => {
                const text = input.value.trim();
                if (!text) return;
                appendMessageToUI(text, 'user', true);
                input.value = '';
                document.querySelector('.welcome-msg').style.display = 'none';
                typingIndicator.style.display = 'block';

                try {
                    const res = await fetch('/Home/GetAiRecommendation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(text)
                    });
                    const data = await res.json();
                    typingIndicator.style.display = 'none';
                    appendMessageToUI(data.reply, 'ai', true);
                    if(isVoiceEnabled) speakText(data.reply);
                } catch (e) { typingIndicator.style.display = 'none'; }
            };

            sendBtn.onclick = sendMessage;
            input.onkeypress = (e) => { if(e.key === 'Enter') sendMessage(); };

            // Speech Recognition
            if ('webkitSpeechRecognition' in window) {
                const rec = new webkitSpeechRecognition();
                rec.lang = 'ro-RO';
                micBtn.onclick = () => rec.start();
                rec.onstart = () => micBtn.classList.add('listening');
                rec.onend = () => micBtn.classList.remove('listening');
                rec.onresult = (e) => { input.value = e.results[0][0].transcript; setTimeout(sendMessage, 500); };
            }

            function appendMessageToUI(text, sender, save) {
                const isUser = sender === 'user';
                const html = `<div class="${isUser ? 'text-end' : 'text-start'} mb-2 fade-in">
                    <div class="d-inline-block p-2 rounded-3 ${isUser ? 'bg-primary text-white' : 'bg-light border'}" style="max-width:85%">${text}</div>
                </div>`;
                msgArea.insertAdjacentHTML('beforeend', html);
                msgArea.scrollTop = msgArea.scrollHeight;
                if(save) {
                    const h = JSON.parse(localStorage.getItem('carRentChatHistory')) || [];
                    h.push({text, sender});
                    localStorage.setItem('carRentChatHistory', JSON.stringify(h));
                }
            }

            function speakText(text) {
                window.speechSynthesis.cancel();
                const clean = text.replace(/<[^>]*>?/gm, '');
                const utterance = new SpeechSynthesisUtterance(clean);
                utterance.lang = clean.match(/[ăâîșț]/i) ? 'ro-RO' : 'en-US';
                window.speechSynthesis.speak(utterance);
            }
        }

        // Autocomplete
        function initializeAutocomplete() {
            const input = document.getElementById('searchInput'), results = document.getElementById('autocompleteResults');
            input.oninput = function() {
                const val = this.value.toLowerCase();
                if(!val) { results.style.display = 'none'; return; }
                const filtered = vehicleSuggestions.filter(s => s.text.toLowerCase().includes(val)).slice(0, 10);
                results.innerHTML = filtered.map(s => `<div class="autocomplete-item" data-val="${s.text}">${s.text} <small class="text-muted">(${s.type})</small></div>`).join('');
                results.style.display = filtered.length ? 'block' : 'none';
                document.querySelectorAll('.autocomplete-item').forEach(i => i.onclick = function() { input.value = this.dataset.val; results.style.display = 'none'; document.getElementById('searchForm').submit(); });
            };
        }
 
        function populateFilterValuesFromUrl() {
            const params = new URLSearchParams(window.location.search);
            ['brandFilter', 'yearFilter', 'priceFilter', 'searchTerm'].forEach(id => {
                const el = document.getElementById(id === 'searchTerm' ? 'searchInput' : id);
                if(el && params.has(id)) el.value = params.get(id);
            });
        }

        function clearFilters() { window.location.href = '@Url.Action("Index", "Home")'; }
    </script>
}