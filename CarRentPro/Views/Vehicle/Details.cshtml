@model CarRentPro.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>@Model.Brand @Model.Model</h1>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Brand @Model.Model"
                 onerror="this.onerror=null; this.src='/images/vehicles/default-car.jpg'">
        </div>
        <div class="col-md-6">
            <h3>Vehicle Information</h3>
            <table class="table">
                <tr>
                    <th>Brand:</th>
                    <td>@Model.Brand</td>
                </tr>
                <tr>
                    <th>Model:</th>
                    <td>@Model.Model</td>
                </tr>
                <tr>
                    <th>Year:</th>
                    <td>@Model.Year</td>
                </tr>
                <tr>
                    <th>Color:</th>
                    <td>@Model.Color</td>
                </tr>
                <tr>
                    <th>Price per Day:</th>
                    <td>$@string.Format("{0:F2}", Model.PricePerDay)</td>
                </tr>
                <tr>
                    <th>Branch:</th>
                    <td>@Model.Branch?.Name</td>
                </tr>
                <tr>
                    <th>Status:</th>
                    <td>
                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rented / Unavailable</span>
                        }
                    </td>
                </tr>
            </table>

            <p><strong>Description:</strong> @Model.Description</p>

            @* Secțiunea de Prezentare Video (din branch-ul AI-and-multimedia) *@
            @if (!string.IsNullOrEmpty(Model.VideoUrl))
            {
                <div class="card mt-3 mb-3 shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0"><i class="fas fa-video me-2"></i>Video Presentation</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="ratio ratio-16x9">
                            @if (Model.VideoUrl.Contains("youtube.com") || Model.VideoUrl.Contains("youtu.be"))
                            {
                                <iframe src="@Model.VideoUrl.Replace("watch?v=", "embed/")" title="YouTube video" allowfullscreen></iframe>
                            }
                            else
                            {
                                <video controls class="w-100">
                                    <source src="@Model.VideoUrl" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>
                            }
                        </div>
                    </div>
                </div>
            }

            <hr />

            <div class="mt-4">
                @if (User.Identity.IsAuthenticated)
                {
                    if (Model.IsAvailable)
                    {
                        <h4>Rent This Vehicle</h4>
                        <a href="@Url.Action("Rent", "Rental", new { id = Model.Id })" class="btn btn-primary btn-lg">
                            <i class="fas fa-car"></i> Rent Now
                        </a>
                        <p class="text-muted mt-2">Click "Rent Now" to proceed with the booking.</p>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <h5><i class="fas fa-exclamation-triangle me-2"></i>Not Available</h5>
                            <p class="mb-0">This vehicle is currently not available for rental. Please check back later.</p>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info border-0 shadow-sm">
                        <h5>Please login to rent this vehicle</h5>
                        <div class="mt-3">
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">Login</a>
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary">Register</a>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4">
                <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>